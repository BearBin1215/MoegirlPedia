{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "oojs",
      "oojs-ui",
      "jquery",
      "node"
    ]
  },
  "exclude": [
    "dist",
  ],
  "include": [
    "src/**/*",
    "scripts/**/*",
    "rspack.config.ts",
    "vitest.config.ts",
    "stylelint.config.ts",
  ]
}
